
import { Resend } from "resend";

const resend = new Resend(process.env.RESEND_API_KEY);

// Escape HTML to prevent HTML injection in email content
function escapeHtml(value = "") {
    return String(value).replace(/[&<>"']/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
    })[char]);
}

// ABB Hotel Booking Enquiry Email
export async function sendBookingEnquiryEmail(data) {
    const {
        name,
        email,
        phone,
        checkIn,
        checkOut,
        guests,
        rooms,
        message,
    } = data;

    const safeName = escapeHtml(name);
    const safeEmail = escapeHtml(email);
    const safePhone = escapeHtml(phone);
    const safeCheckIn = escapeHtml(checkIn);
    const safeCheckOut = escapeHtml(checkOut);
    const safeGuests = escapeHtml(guests);
    const safeRooms = escapeHtml(rooms);
    const safeMessage = escapeHtml(message || "N/A");

    const { data: result, error } = await resend.emails.send({
        from: process.env.EMAIL_FROM,
        to: [process.env.CONTACT_EMAIL],
        replyTo: email,
        subject: `New Booking Enquiry - ${String(name).replace(/[\r\n]/g, " ")}`,
        html: `
            <h2>New Booking Enquiry - ABB Hotel</h2>

            <p><strong>Name:</strong> ${safeName}</p>
            <p><strong>Email:</strong> ${safeEmail}</p>
            <p><strong>Phone:</strong> ${safePhone}</p>
            <p><strong>Check-in:</strong> ${safeCheckIn}</p>
            <p><strong>Check-out:</strong> ${safeCheckOut}</p>
            <p><strong>Guests:</strong> ${safeGuests}</p>
            <p><strong>Rooms:</strong> ${safeRooms}</p>
            <p><strong>Message:</strong> ${safeMessage}</p>
        `,
    });

    if (error) {
        console.error("Resend Booking Email Error:", error);
        throw new Error(error.message);
    }

    return result;
}

// The Urban Canteen Contact Enquiry Email
export async function sendContactEnquiryEmail(data) {
    const { name, email, message } = data;

    const safeName = escapeHtml(name);
    const safeEmail = escapeHtml(email);
    const safeMessage = escapeHtml(message).replace(/\r?\n/g, "<br>");

    const { data: result, error } = await resend.emails.send({
        from: process.env.EMAIL_FROM,
        to: [process.env.CONTACT_EMAIL],
        replyTo: email,
        subject: "New Contact Enquiry - The Urban Canteen",
        html: `
            <h2>New Contact Enquiry - The Urban Canteen</h2>

            <p><strong>Name:</strong> ${safeName}</p>
            <p><strong>Email:</strong> ${safeEmail}</p>

            <h3>Message:</h3>
            <p>${safeMessage}</p>

            <hr />
            <p>This enquiry was submitted through The Urban Canteen website.</p>
        `,
    });

    if (error) {
        console.error("Resend Contact Email Error:", error);
        throw new Error(error.message);
    }

    return result;
}



// The Urban Canteen Reservation Email
export async function sendReservationEmail(data) {
    const { name, people, phone, date } = data;

    const safeName = escapeHtml(name);
    const safePhone = escapeHtml(phone);
    const safePeople = escapeHtml(
        people.replace("-people", " Person(s)")
    );
    const safeDate = escapeHtml(date);

    const { data: result, error } = await resend.emails.send({
        from: process.env.EMAIL_FROM,
        to: [process.env.CONTACT_EMAIL],
        subject: "New Table Reservation Request - The Urban Canteen",
        html: `
            <h2>New Reservation Request - The Urban Canteen</h2>

            <p><strong>Name:</strong> ${safeName}</p>
            <p><strong>Number of People:</strong> ${safePeople}</p>
            <p><strong>Phone Number:</strong> ${safePhone}</p>
            <p><strong>Reservation Date:</strong> ${safeDate}</p>

            <hr />

            <p>
                A new reservation request has been submitted
                through The Urban Canteen website.
            </p>

            <p>Please contact the customer to confirm the reservation.</p>
        `,
    });

    if (error) {
        console.error("Resend Reservation Email Error:", error);
        throw new Error(error.message);
    }

    return result;
}
